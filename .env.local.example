# Storyblok Space ID (Settings → Space)
STORYBLOK_SPACE_ID=

# Personal Access Token for Management API
# https://app.storyblok.com/#/me/account?tab=token
STORYBLOK_OAUTH_TOKEN=

# Optional: HMAC secret configured at Settings → Webhooks
STORYBLOK_WEBHOOK_SECRET=

# Optional: Content type technical name to use when creating empty stories.
# Must match a Content Type Block registered in your Storyblok Block Library.
# Defaults to "page" if not set.
STORYBLOK_CONTENT_TYPE=

# Vercel KV (auto-populated when you connect a KV store to the project)
# Pull locally: `vercel env pull .env.local`
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
